<?xml version="1.0" encoding="UTF-8"?>
<!-- Ferrum Paint native layered image format. Installed by packaging/install-linux.sh. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-ferrum-paint">
    <comment>Ferrum Paint image</comment>
    <generic-icon name="image-x-generic"/>
    <magic priority="60">
      <match type="string" value="FERRUMP1" offset="0"/>
    </magic>
    <glob pattern="*.ferrum"/>
  </mime-type>
</mime-info>